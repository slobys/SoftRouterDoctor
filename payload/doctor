#!/bin/sh

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
. /usr/share/libubox/jshn.sh

REVISION_FILE=/usr/share/soft-router-doctor/installed
REPAIR_LOCK=/var/lock/soft-router-doctor-repair
APK_CACHE=/var/cache/apk
APK_CUSTOM_CACHE=/etc/apk/cache
APK_DB_LOCK=/lib/apk/db/lock
INIT_DIR=/etc/init.d
RC_DIR=/etc/rc.d
OPTIMIZE_LOCK=/var/lock/soft-router-doctor-optimization

field() {
	printf '%s\n' "$1" | jsonfilter -e "$2" 2>/dev/null
}

identity() {
	json_add_string version '0.4.0-dev'
	IFS= read -r revision 2>/dev/null < "$REVISION_FILE" || revision=uninstalled
	json_add_string revision "$revision"
}

check() {
	# IDs are internal constants. Preserve the status for cross-check conclusions.
	export "_srd_$1=$2"
	json_add_object ''
	json_add_string id "$1"
	json_add_string state "$2"
	json_add_string detail "$3"
	json_close_object
}

check_wan() {
	interface=$1
	status=$2
	address=$3
	label=$4
	if [ -z "$status" ]; then
		check "$interface" skipped "未找到 $label 接口或无法读取状态。旁路由与自定义接口可能使用其他名称。"
		return
	fi

	if [ "$(field "$status" '@.up')" != true ]; then
		check "$interface" warning "$label 接口存在，但未处于运行状态。请确认该接口是否承担上网。"
	elif [ -z "$(field "$status" "$address")" ]; then
		check "$interface" warning "$label 接口已运行，但未检测到该协议的地址。"
	else
		check "$interface" passed "$label 接口已运行且有地址。"
	fi
}

check_wan_link() {
	device=$(field "$1" '@.device')
	case "$device" in
		''|*[!A-Za-z0-9_.:@-]*)
			check wan_link skipped '无法识别 WAN 设备。'
			return ;;
	esac
	status=$(ubus -S call network.device status "{\"name\":\"$device\"}" 2>/dev/null)
	case "$(field "$status" '@.carrier')" in
		true) check wan_link passed 'WAN 设备报告链路已建立。' ;;
		false) check wan_link warning 'WAN 网口未报告载波。' ;;
		*) check wan_link skipped '该接口未提供可判断的载波状态。' ;;
	esac
}

route_state() {
	routes=$(ip "-$1" route show default 2>/dev/null) || {
		check "$2" skipped '系统未返回默认路由信息。'
		return 1
	}
	if [ -z "$routes" ]; then
		if [ "$1" = 6 ] && [ "$wan6_active" != true ]; then
			check "$2" skipped '未检测到正在运行的 WAN6 或 IPv6 默认路由，未验证 IPv6 公网。'
		else
			check "$2" warning '主路由表未找到该协议的默认出口。自定义策略路由需结合配置判断。'
		fi
		return 1
	fi
	check "$2" passed '主路由表存在该协议的默认路由。'
}

probe_ip() {
	family=$1
	primary=$2
	secondary=$3
	if timeout 3 ping "-$family" -c 1 -W 2 "$primary" >/dev/null 2>&1 ||
		timeout 3 ping "-$family" -c 1 -W 2 "$secondary" >/dev/null 2>&1; then
		check "internet_v$family" passed '至少一个固定公网 IP 返回了 ICMP 回包。'
	elif [ "$4" = passed ]; then
		check "internet_v$family" skipped '测试地址未回 Ping，但同协议的 HTTPS 已通过。'
	else
		check "internet_v$family" warning '两个测试地址均未回 Ping。目标过滤 ICMP 时也会出现此结果。'
	fi
}

probe_https() {
	local family="$1" output result detail
	if ! command -v curl >/dev/null 2>&1; then
		check "https_v$family" skipped '路由器未安装 curl，未进行 HTTPS 探测。'
		return
	fi
	output=$(curl -q "-$family" --noproxy '*' --proto '=https' --head \
		--connect-timeout 2 --max-time 4 --output /dev/null \
		--write-out '%{http_code} %{time_total}' https://example.com/ 2>/dev/null)
	result=$?
	case "$result" in
		0) detail=$(printf '%s\n' "$output" | awk '$1 ~ /^[1-5][0-9][0-9]$/ {
				printf "测试站点返回 HTTP %s，本次 HTTPS 请求约 %.0f 毫秒。", $1, $2 * 1000
			}')
			if [ -n "$detail" ]; then
				check "https_v$family" passed "$detail"
				return
			fi
			detail='TLS 请求结束，但未取得有效 HTTP 响应。' ;;
		6) detail='HTTPS 探测未能解析测试站点的地址。' ;;
		7) detail='无法建立到测试站点的 TCP 连接。' ;;
		28) detail='访问测试站点超时。' ;;
		35) detail='与测试站点的 TLS 握手失败。' ;;
		60|77) detail='HTTPS 证书校验失败。请检查路由器时间和 CA 证书。' ;;
		*) detail='未能确认测试站点的 HTTPS 可用。' ;;
	esac
	check "https_v$family" warning "$detail"
}

check_prefix() {
	if [ -z "$(field "$wan6" '@["ipv6-prefix"][0].address')" ] &&
		[ -z "$(field "$wan" '@["ipv6-prefix"][0].address')" ] &&
		[ -z "$(field "$auto6" '@["ipv6-prefix"][0].address')" ]; then
		check prefix skipped '未在常用 WAN 接口发现上游委派前缀。是否需要委派取决于你的 IPv6 接入方式。'
		check lan_prefix skipped '未发现上游委派前缀，未验证 LAN 前缀分配。'
		return
	fi
	check prefix passed '从上游取到了 IPv6 委派前缀。'

	lan=$(ubus -S call network.interface.lan status 2>/dev/null)
	lan_assignments=$(field "$lan" '@["ipv6-prefix-assignment"][*].address')
	if [ "$(field "$lan" '@.up')" != true ]; then
		check lan_prefix skipped '未找到正在运行的标准 LAN 接口。'
	elif printf '%s\n' "$lan_assignments" | grep -Eiq '^[23][[:xdigit:]]{3}:'; then
		check lan_prefix passed 'LAN 接口已有全局 IPv6 前缀分配。终端是否收到仍需从终端检查。'
	elif [ "$(uci -q get dhcp.lan.ra)" = relay ] ||
		[ "$(uci -q get dhcp.lan.dhcpv6)" = relay ]; then
		check lan_prefix skipped 'LAN 使用 IPv6 中继，跳过路由模式的前缀分配判断。'
	else
		check lan_prefix warning 'WAN 有委派前缀，标准 LAN 接口未显示全局前缀分配。'
	fi
}

check_writable() {
	flags=$(awk '$2 == "/overlay" { overlay = $4 } $2 == "/" { root = $4 }
		END { print (overlay ? overlay : root) }' /proc/mounts)
	case ",$flags," in
		*,ro,*) check writable failed '系统可写层或根挂载处于只读状态。' ;;
		*,rw,*) check writable passed '系统可写层挂载为可读写。' ;;
		*) check writable skipped '无法确认系统可写层的挂载状态。' ;;
	esac
}

resolve_name() {
	# BusyBox may print the resolver address even when the answer is empty.
	timeout 3 nslookup "$@" 2>/dev/null | awk '
		/^Name:[[:space:]]/ { answer = 1 }
		answer && /^[[:space:]]*Address([[:space:]]+[0-9]+)?:[[:space:]]*[^[:space:]]/ { found = 1 }
		END { exit !found }
	'
}

dns_port_free() {
	set -- /proc/net/tcp /proc/net/udp
	[ -r "$1" ] && [ -r "$2" ] || return 1
	for sockets in /proc/net/tcp6 /proc/net/udp6; do
		[ ! -e "$sockets" ] || set -- "$@" "$sockets"
	done
	awk 'FNR == 1 { seen++ } FNR > 1 && $2 ~ /:0035$/ { used = 1 }
		END { exit (used || seen != ARGC - 1) }' "$@" 2>/dev/null
}

dns_can_start() {
	[ -x /etc/init.d/dnsmasq ] || return 1
	/etc/init.d/dnsmasq enabled >/dev/null 2>&1 || return 1

	sections=$(uci -q show dhcp | sed -n 's/^dhcp\.\([^=]*\)=dnsmasq$/\1/p')
	[ -n "$sections" ] || return 1
	case "$sections" in
		'@dnsmasq[0]') ;;
		*[!A-Za-z0-9_]*) return 1 ;;
	esac
	[ "$(uci -q get "dhcp.$sections.disabled")" != 1 ] || return 1
	case "$(uci -q get "dhcp.$sections.port")" in
		''|53) ;;
		*) return 1 ;;
	esac
	[ -z "$(uci -q get "dhcp.$sections.interface")" ] || return 1
	[ -z "$(uci -q get "dhcp.$sections.listen_address")" ] || return 1
	[ -z "$(uci -q get "dhcp.$sections.listen-address")" ] || return 1
	[ -z "$(uci -q get "dhcp.$sections.notinterface")" ] || return 1
	[ -z "$(uci -q get "dhcp.$sections.confdir")" ] || return 1
	service=$(ubus -S call service list '{"name":"dnsmasq"}' 2>/dev/null) || return 1
	field "$service" '@.dnsmasq.instances.*.running' | grep -qx true && return 1
	pidof dnsmasq >/dev/null 2>&1 && return 1
	dns_port_free
}

check_dns_service() {
	if dns_can_start; then
		check dnsmasq failed 'dnsmasq 已启用，但未见运行实例，且未检测到 53 端口冲突。可以尝试启动服务。'
		dns_repair=1
	elif pidof dnsmasq >/dev/null 2>&1; then
		check dnsmasq passed '检测到 dnsmasq 进程。请结合 DNS 查询项判断解析是否正常。'
	else
		check dnsmasq skipped '未检测到 dnsmasq 进程，且不满足安全启动条件。可能使用其他 DNS 服务或自定义配置。'
	fi
}

memory_percent() {
	awk '/^MemTotal:/ { total = $2 } /^MemAvailable:/ { free = $2 }
		END { if (total && free ~ /^[0-9]+$/) print int(free / total * 100) }' /proc/meminfo
}

writable_path() {
	if [ -d /overlay ]; then printf '/overlay\n'; else printf '/\n'; fi
}

check_resources() {
	usage=$(df -Pk "$(writable_path)" 2>/dev/null | awk 'NR == 2 { print $5 }')
	[ -n "$usage" ] || usage=$(df -Pk / 2>/dev/null | awk 'NR == 2 { print $5 }')
	percent=$(printf '%s\n' "$usage" | awk '/^[0-9]+%$/ { sub(/%$/, ""); print }')
	if [ -z "$percent" ]; then
		check storage skipped '无法读取系统分区占用。'
	elif [ "$percent" -ge 90 ]; then
		check storage warning "系统可写分区或根分区使用率为 $percent%，接近写满。"
	else
		check storage passed "系统可写分区或根分区使用率为 $percent%。"
	fi

	available=$(memory_percent)
	if [ -z "$available" ]; then
		check memory skipped '内核未提供可用内存估算。'
	elif [ "$available" -le 10 ]; then
		check memory warning "预计可用内存为 $available%，请检查高占用进程。"
	else
		check memory passed "预计可用内存为 $available%。"
	fi
}

finding() {
	if [ -z "$first_finding" ] || { [ "$first_level" != high ] && [ "$2" = high ]; }; then
		first_finding=$3
		first_level=$2
	fi
	json_add_object ''
	json_add_string id "$1"
	json_add_string level "$2"
	json_add_string title "$3"
	json_add_string advice "$4"
	json_add_string action "$5"
	shift 5
	json_add_array evidence
	for evidence_id in "$@"; do
		json_add_string '' "$evidence_id"
	done
	json_close_array
	json_close_object
}

assemble_findings() {
	first_finding=
	first_level=
	json_add_array findings
	if [ "$_srd_wan_link" = warning ] && [ "$have_v4" -eq 0 ] && [ "$have_v6" -eq 0 ]; then
		finding wan_disconnected high 'WAN 没有链路，且未发现默认出口' \
			'如果这台设备负责上网，先检查 WAN 网线、光猫或上级路由的网口。恢复链接后再体检。' '' wan_link route_v4 route_v6
	elif [ "$_srd_route_v4" = warning ] && [ "$have_v6" -eq 0 ]; then
		finding no_default_route review '没有从主路由表找到默认出口' \
			'检查 WAN 是否拿到了网关。旁路由请核对上级网关，使用策略路由时核对实际出站链路。' '' wan route_v4
	fi
	if [ "$_srd_writable" = failed ]; then
		finding filesystem_readonly high '配置可能无法保存' \
			'先导出重要配置，再检查系统日志中的存储或文件系统错误。' '' writable storage
	fi
	if [ "$dns_repair" -eq 1 ]; then
		finding dns_service_stopped high '已启用的 dnsmasq 停止了' \
			'如果这台设备负责 DNS 或 DHCP，可以沿用现有配置启动服务，并实际查询域名复查。' start_dnsmasq dnsmasq dns
	elif [ "$_srd_dns" = warning ] &&
		{ [ "$_srd_internet_v4" = passed ] || [ "$_srd_internet_v6" = passed ]; }; then
		finding dns_resolution high '公网 IP 有回包，但域名解析失败' \
			'先检查当前 DNS 服务的转发目标，再核对上游 DNS 是否响应。' '' dns internet_v4 internet_v6
	fi

	if [ "$_srd_https_v4" = passed ] && [ "$_srd_https_v6" = warning ]; then
		finding ipv6_web review 'IPv4 网页可达，IPv6 网页探测失败' \
			'优先检查 IPv6 默认路由和上游连通性。用终端复测网页，确认问题是否只影响部分站点。' '' https_v4 https_v6 route_v6
	elif [ "$_srd_https_v6" = passed ] && [ "$_srd_https_v4" = warning ]; then
		finding ipv4_web review 'IPv6 网页可达，IPv4 网页探测失败' \
			'检查 IPv4 出口、策略路由和防火墙。可以先从终端验证其他 IPv4 站点。' '' https_v6 https_v4 route_v4
	elif [ "$_srd_dns" = passed ] &&
		{ [ "$_srd_https_v4" = warning ] || [ "$_srd_https_v6" = warning ]; }; then
		finding web_connection review '有域名可解析，测试站点仍未确认可达' \
			'展开证据查看是连接超时、TLS 校验失败，还是测试站点单独异常，再从终端验证其他网站。' '' dns https_v4 https_v6
	elif [ "$_srd_dns" = warning ] && [ "$first_finding" = '' ]; then
		finding upstream_unverified review '域名解析和公网连接需要分别核实' \
			'先核对出口能否上网，再检查 DNS 上游。如果只有一台终端异常，优先在该终端复查。' '' dns internet_v4 internet_v6
	fi
	if [ "$_srd_lan_prefix" = warning ]; then
		finding missing_lan_prefix review '上游有 IPv6 前缀，LAN 未显示分配' \
			'如果内网需要路由模式 IPv6，到 LAN 设置核对分配长度和 RA，再从终端检查是否收到 IPv6 地址。' '' prefix lan_prefix
	fi
	if [ "$_srd_storage" = warning ] && [ "$_srd_writable" != failed ]; then
		finding low_storage review '系统可写空间接近用完' \
			'查看可写分区占用，优先处理确认可删的旧文件，或扩容后重新体检。' '' storage writable
	fi
	if [ "$_srd_memory" = warning ]; then
		finding low_memory review '路由器可用内存偏低' \
			'到 LuCI 的进程列表查看高占用服务，并观察占用是否持续增长。' '' memory
	fi
	json_close_array
}

scan() {
	mode=$1
	board=$(ubus -S call system board 2>/dev/null)
	wan=$(ubus -S call network.interface.wan status 2>/dev/null)
	wan6=$(ubus -S call network.interface.wan6 status 2>/dev/null)
	auto6=$(ubus -S call network.interface.wan_6 status 2>/dev/null)
	wan6_label=WAN6
	if [ "$(field "$wan6" '@.up')" != true ] && [ "$(field "$auto6" '@.up')" = true ]; then
		wan6=$auto6
		wan6_label='自动派生的 WAN6'
	fi
	wan6_active=$(field "$wan6" '@.up')
	dns_repair=0
	have_v4=0
	have_v6=0

	json_init
	identity
	json_add_string timestamp "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
	json_add_string firmware "$(field "$board" '@.release.description')"
	json_add_string model "$(field "$board" '@.model')"
	json_add_string mode "$mode"
	json_add_array checks
	check_wan_link "$wan"
	check_wan wan "$wan" '@["ipv4-address"][0].address' 'WAN'
	if [ "$wan6_active" = true ]; then
		check_wan wan6 "$wan6" '@["ipv6-address"][0].address' "$wan6_label"
	else
		check wan6 skipped '未发现正在运行的常用 WAN6 接口。'
	fi
	check_prefix
	route_state 4 route_v4 && have_v4=1
	route_state 6 route_v6 && have_v6=1
	check_dns_service
	if [ "$mode" = online ]; then
		if resolve_name example.com || resolve_name openwrt.org; then
			check dns passed '当前解析器取得了至少一个测试域名的地址。'
		else
			check dns warning '两个测试域名都未返回可用地址。'
		fi
		if [ "$have_v4" -eq 1 ]; then
			probe_https 4
			probe_ip 4 1.1.1.1 223.5.5.5 "$_srd_https_v4"
		else
			check https_v4 skipped '缺少 IPv4 默认路由，未验证 HTTPS。'
			check internet_v4 skipped '缺少 IPv4 默认路由，未发送 ICMP 探测。'
		fi
		if [ "$have_v6" -eq 1 ]; then
			probe_https 6
			probe_ip 6 2606:4700:4700::1111 2001:4860:4860::8888 "$_srd_https_v6"
		else
			check https_v6 skipped '缺少 IPv6 默认路由，未验证 HTTPS。'
			check internet_v6 skipped '缺少 IPv6 默认路由，未发送 ICMP 探测。'
		fi
	else
		check dns skipped '仅检查本机，未查询测试域名。'
		check internet_v4 skipped '仅检查本机，未发送公网探测。'
		check internet_v6 skipped '仅检查本机，未发送公网探测。'
		check https_v4 skipped '仅检查本机，未访问测试网站。'
		check https_v6 skipped '仅检查本机，未访问测试网站。'
	fi
	check_writable
	check_resources
	json_close_array
	json_add_boolean can_start_dnsmasq "$dns_repair"
	assemble_findings
	if [ -n "$first_finding" ]; then
		json_add_string summary "$first_finding"
	elif [ "$mode" = local ]; then
		json_add_string summary '已检查接口、服务和系统资源。'
	elif [ "$_srd_https_v4" = passed ] || [ "$_srd_https_v6" = passed ]; then
		json_add_string summary '从路由器访问测试网站成功。'
	else
		json_add_string summary '本轮未取得网页访问通过的证据，请查看未验证项。'
	fi
	json_dump
}

repair_result() {
	json_init
	json_add_string state "$1"
	json_add_string detail "$2"
	json_dump
}

repair_dns() {
	if ! mkdir "$REPAIR_LOCK" 2>/dev/null; then
		repair_result rejected '已有修复正在运行，或无法取得修复锁。'
		return
	fi
	trap 'rmdir "$REPAIR_LOCK" 2>/dev/null' EXIT
	trap 'exit 1' HUP INT TERM

	if ! dns_can_start; then
		repair_result rejected '当前条件不允许启动 dnsmasq。请重新检测后查看服务状态。'
		return
	fi
	if ! timeout 8 /etc/init.d/dnsmasq start >/dev/null 2>&1; then
		repair_result failed '启动命令失败或超时。可在系统日志查看原因。'
		return
	fi
	for attempt in 1 2; do
		if pidof dnsmasq >/dev/null 2>&1 && resolve_name openwrt.org 127.0.0.1; then
			repair_result repaired 'dnsmasq 已启动，且通过本机 127.0.0.1 的 DNS 查询复测。'
			return
		fi
		[ "$attempt" -eq 2 ] || sleep 1
	done
	repair_result unverified '已尝试启动，DNS 查询仍未通过。请检查 dnsmasq 日志或上游 DNS，并复测局域网客户端。'
}

cpu_counters() {
	awk '$1 == "cpu" {
		for (i = 2; i <= 9; i++) total += $i
		printf "%.0f %.0f %.0f\n", total, $5, $6
		exit
	}' /proc/stat
}

sample_performance() {
	local scratch="$1" first second writable
	first=$(cpu_counters)
	[ -z "$scratch" ] || process_snapshot 0 > "$scratch/before"
	sleep 1
	second=$(cpu_counters)
	[ -z "$scratch" ] || process_snapshot 1 > "$scratch/after"
	cpu_usage=$(awk -v first="$first" -v second="$second" 'BEGIN {
		split(first, a, " "); split(second, b, " ")
		count = b[1] - a[1]
		busy = count - (b[2] - a[2]) - (b[3] - a[3])
		wait = b[3] - a[3]
		if (a[1] && count > 0 && busy >= 0 && busy <= count && wait >= 0 && wait <= count)
			printf "%.0f %.0f %.0f", 100 * busy / count, 100 * wait / count, count
	}')
	IFS=' ' read -r cpu_busy cpu_wait cpu_delta <<EOF
$cpu_usage
EOF
	mem_available=$(memory_percent)
	writable=$(writable_path)
	storage_free=$(df -Pk "$writable" 2>/dev/null | awk 'NR == 2 && $4 ~ /^[0-9]+$/ { print $4 }')
}

cache_occupancy() {
	local usage
	usage=$(timeout 4 du -sk "$cache_dir" 2>/dev/null) || return 1
	printf '%s\n' "$usage" | awk '$1 ~ /^[0-9]+$/ { print $1; exit }'
}

cache_signature() {
	[ ! -L "$1" ] && [ -f "$1" ] || return 1
	stat -c '%i:%s:%Y:%u:%h' "$1" 2>/dev/null
}

inspect_cache() {
	local version directory mode output names candidate signature
	plan_state=unavailable
	plan_detail='当前只支持 apk 3 的默认缓存目录。'
	plan_count=0
	plan_token=
	plan_entries=
	cache_kib=
	cache_temporary=0
	command -v apk >/dev/null 2>&1 || return 0
	version=$(apk --version 2>/dev/null)
	case "$version" in 'apk-tools 3.'*) ;; *) return 0 ;; esac
	if [ -e "$APK_CUSTOM_CACHE" ] || [ -L "$APK_CUSTOM_CACHE" ]; then
		plan_detail='检测到自定义 APK 缓存，保留其中的离线安装文件。'
		return 0
	fi
	cache_dir=$(readlink -f "$APK_CACHE" 2>/dev/null)
	case "$cache_dir" in
		/tmp/cache/apk) cache_temporary=1 ;;
		/var/cache/apk) ;;
		*) return 0 ;;
	esac
	for directory in "${cache_dir%/*}" "$cache_dir"; do
		mode=$(stat -c '%u %a' "$directory" 2>/dev/null)
		case "$mode" in '0 '[0-7][0145][0145]) ;; *) return 0 ;; esac
	done
	cache_kib=$(cache_occupancy)
	if [ -z "$cache_kib" ]; then
		plan_detail='暂时无法读取 APK 缓存的占用。'
		return 0
	fi
	if ! command -v flock >/dev/null 2>&1 || [ -L "$APK_DB_LOCK" ] || [ ! -f "$APK_DB_LOCK" ]; then
		plan_detail='未检测到可用的 APK 数据库锁，跳过回收。'
		return 0
	fi
	if pidof apk >/dev/null 2>&1; then
		plan_state=busy
		plan_detail='软件包管理器正在运行，完成后可重新检查。'
		return 0
	fi
	output=$(LC_ALL=C APK_CONFIG=/dev/null timeout 6 apk \
		--no-network --no-logfile --cache-dir "$cache_dir" -vv --simulate cache clean 2>&1) || {
		plan_detail='APK 无法确认过期缓存，回收已跳过。'
		return 0
	}
	names=$(printf '%s\n' "$output" | LC_ALL=C awk '
		/^deleting APKINDEX\.[[:xdigit:]]{8}\.tar\.gz$/ ||
		/^deleting [A-Za-z0-9][A-Za-z0-9_.+-]*-[0-9][A-Za-z0-9_.+-]*\.[[:xdigit:]]{8}\.apk$/ {
			print substr($0, 10)
		}' | LC_ALL=C sort -u)
	plan_entries=$(printf '%s\n' "$names" | while IFS= read -r candidate; do
		[ -n "$candidate" ] || continue
		signature=$(cache_signature "$cache_dir/$candidate") || continue
		case "$signature" in *:0:1) printf '%s %s\n' "$candidate" "$signature" ;; esac
	done)
	if [ -z "$plan_entries" ]; then
		plan_state=empty
		plan_detail='暂无符合条件的过期 APK 缓存。'
		return 0
	fi
	plan_count=$(printf '%s\n' "$plan_entries" | awk 'END { print NR }')
	plan_token=$(printf '%s\n' "$cache_dir" "$plan_entries" | sha256sum)
	plan_token=${plan_token%% *}
	plan_state=ready
	plan_detail='软件包管理器确认这些缓存已过期。清理后需要时可重新下载。'
}

acceleration_plan() (
	scratch=$(mktemp -d /tmp/soft-router-doctor-processes.XXXXXX 2>/dev/null)
	trap '[ -z "$scratch" ] || rm -rf "$scratch"' EXIT
	trap 'exit 1' HUP INT TERM
	sample_performance "$scratch"
	inspect_cache
	json_init
	json_add_string state "$plan_state"
	json_add_string detail "$plan_detail"
	json_add_int cpu_busy "${cpu_busy:--1}"
	json_add_int cpu_iowait "${cpu_wait:--1}"
	json_add_int memory_available "${mem_available:--1}"
	json_add_int storage_free_kib "${storage_free:--1}"
	json_add_int cache_kib "${cache_kib:--1}"
	json_add_int candidate_count "$plan_count"
	json_add_boolean temporary "$cache_temporary"
	json_add_string token "$plan_token"
	process_rankings "$scratch" "$cpu_delta"
	add_service_inventory
	json_dump
)

apply_acceleration() (
	requested=$1
	case "$requested" in
		''|*[!a-f0-9]*) repair_result rejected '请重新检查可回收项。'; exit ;;
	esac
	if [ "${#requested}" -ne 64 ] || [ -L "$APK_DB_LOCK" ] || [ ! -f "$APK_DB_LOCK" ]; then
		repair_result rejected '请重新检查可回收项。'
		exit
	fi
	if ! flock -n 9; then
		repair_result busy '软件包数据库正在使用，暂缓回收。'
		exit
	fi
	inspect_cache
	if [ "$plan_state" != ready ]; then
		repair_result "$plan_state" "$plan_detail"
		exit
	fi
	if [ "$requested" != "$plan_token" ]; then
		repair_result changed '缓存内容已变化，请检查新清单后再确认。'
		exit
	fi

	removed=0
	while IFS=' ' read -r candidate signature; do
		path="$cache_dir/$candidate"
		if [ "$(cache_signature "$path")" = "$signature" ] && rm -- "$path" 2>/dev/null; then
			removed=$((removed + 1))
		fi
	done <<EOF
$plan_entries
EOF
	after=$(cache_occupancy)
	reclaimed=-1
	if [ -n "$after" ]; then
		reclaimed=$((cache_kib - after))
		[ "$reclaimed" -ge 0 ] || reclaimed=0
	fi
	json_init
	if [ "$removed" -eq "$plan_count" ]; then
		json_add_string state applied
		json_add_string detail '已回收过期 APK 缓存。'
	elif [ "$removed" -gt 0 ]; then
		json_add_string state partial
		json_add_string detail '已回收部分缓存。其余文件已变化或无法删除，请重新检查。'
	else
		json_add_string state rejected
		json_add_string detail '本次未删除缓存，请重新检查。'
	fi
	json_add_int removed "$removed"
	json_add_int reclaimed_kib "$reclaimed"
	json_add_boolean temporary "$cache_temporary"
	json_dump
) 9< "$APK_DB_LOCK" 2>/dev/null

process_snapshot() {
	LC_ALL=C awk -v memory="$1" -v observer="$$" 'BEGIN {
		for (i = 1; i < ARGC; i++) {
			file = ARGV[i]
			if ((getline row < file) != 1) { close(file); continue }
			close(file)
			pid = row + 0
			if (!pid || pid == observer) continue
			name = row
			sub(/^[0-9]+ \(/, "", name)
			sub(/\) [^)]*$/, "", name)
			gsub(/[^-A-Za-z0-9 _+@.():]/, "?", name)
			sub(/^.*\) /, "", row)
			split(row, f, " ")
			if (f[20] !~ /^[0-9]+$/) continue
			rss = -1
			if (memory) {
				sub(/\/stat$/, "/status", file)
				while ((getline line < file) > 0) {
					if (line ~ /^VmRSS:/) { split(line, m, " "); rss = m[2]+0; break }
				}
				close(file)
			}
			printf "%d|%s|%.0f|%s|%d\n", pid, f[20], f[12]+f[13], name, rss
		}
	}' /proc/[0-9]*/stat 2>/dev/null
}

process_rankings() {
	local scratch="$1" total_delta="$2" key metric pid cpu rss name
	if [ -n "$scratch" ]; then
		LC_ALL=C awk -F '|' -v total="$total_delta" '
			FILENAME == ARGV[1] { ticks[$1 "|" $2] = $3; next }
			{ id = $1 "|" $2
			  cpu = -1
			  if ((id in ticks) && total > 0 && $3 >= ticks[id] && $3 - ticks[id] <= total)
				cpu = 100 * ($3 - ticks[id]) / total
			  printf "%s|%.1f|%s|%s\n", $1, cpu, $5, $4 }
		' "$scratch/before" "$scratch/after" > "$scratch/processes"
	fi
	for metric in cpu memory; do
		case "$metric" in cpu) key=2 ;; memory) key=3 ;; esac
		json_add_array "top_$metric"
		if [ -n "$scratch" ]; then
			awk -F '|' -v key="$key" '$key > 0 { print $key "|" $0 }' "$scratch/processes" |
				LC_ALL=C sort -nr | head -n 8 | cut -d '|' -f 2- > "$scratch/top"
			while IFS='|' read -r pid cpu rss name; do
				json_add_object ''
				json_add_int pid "$pid"
				json_add_string name "$name"
				json_add_string cpu_percent "$cpu"
				json_add_int rss_kib "$rss"
				json_close_object
			done < "$scratch/top"
		fi
		json_close_array
	done
}

optional_service() {
	package_alt=
	case "$1" in
		samba4) package=samba4-server; label='Samba 文件共享'; impact='停止会断开 SMB 文件共享连接。' ;;
		avahi-daemon) package=avahi-daemon; package_alt=avahi-dbus-daemon; label='Avahi 局域网发现'; impact='停止后可能无法通过 .local 或自动发现访问局域网设备。' ;;
		wsdd2) package=wsdd2; label='Windows 网络发现'; impact='停止后设备可能不再出现在 Windows 的网络列表中。' ;;
		minidlna) package=minidlna; label='DLNA 媒体共享'; impact='停止会中断媒体库发现和播放。' ;;
		collectd) package=collectd; label='Collectd 监控采集'; impact='停止后会暂停该服务采集的性能统计和上报。' ;;
		vnstat) package=vnstat2; label='vnStat 流量统计'; impact='停止后该服务将暂时停止记录流量。' ;;
		aria2) package=aria2; label='Aria2 下载服务'; impact='停止会中断下载和做种。' ;;
		transmission) package=transmission-daemon; label='Transmission 下载服务'; impact='停止会中断下载和做种。' ;;
		*) return 1 ;;
	esac
	[ -n "$package_alt" ] || package_alt=$package
}

inspect_service() {
	local owner data enabled_status
	service_id=$1
	optional_service "$service_id" || return 1
	service_init="$INIT_DIR/$service_id"
	[ -f "$service_init" ] && [ -x "$service_init" ] && [ ! -L "$service_init" ] || return 1
	if command -v apk >/dev/null 2>&1; then
		owner=$(LC_ALL=C timeout 3 apk info --who-owns "$service_init" 2>/dev/null | awk '/ is owned by / { print $NF }')
		case "$owner" in "$package"-[0-9]*|"$package_alt"-[0-9]*) ;; *) return 1 ;; esac
	elif command -v opkg >/dev/null 2>&1; then
		owner=$(LC_ALL=C timeout 3 opkg search "$service_init" 2>/dev/null | awk 'NR == 1 { print $1 }')
		[ "$owner" = "$package" ] || [ "$owner" = "$package_alt" ] || return 1
	else
		return 1
	fi
	data=$(ubus -S call service list "{\"name\":\"$service_id\"}" 2>/dev/null) || return 1
	service_enabled=0
	service_running=0
	timeout 2 "$service_init" enabled >/dev/null 2>&1
	enabled_status=$?
	case "$enabled_status" in 0) service_enabled=1 ;; 1) ;; *) return 1 ;; esac
	field "$data" "@[\"$service_id\"].instances.*.running" | grep -qx true && service_running=1
	service_pids=$(field "$data" "@[\"$service_id\"].instances.*.pid" | LC_ALL=C sort -n)
	service_hash=$(sha256sum "$service_init" 2>/dev/null) || return 1
	service_token=$(printf '%s\n' "$service_id" "$service_enabled" "$service_running" "$service_pids" "$service_hash" | sha256sum)
	service_token=${service_token%% *}
}

add_service_inventory() {
	local candidate link name pid
	json_add_array services
	for candidate in samba4 avahi-daemon wsdd2 minidlna collectd vnstat aria2 transmission; do
		inspect_service "$candidate" || continue
		if [ "$service_enabled" -eq 0 ] && [ "$service_running" -eq 0 ]; then continue; fi
		json_add_object ''
		json_add_string id "$candidate"
		json_add_string label "$label"
		json_add_string impact "$impact"
		json_add_boolean running "$service_running"
		json_add_boolean enabled "$service_enabled"
		json_add_string token "$service_token"
		json_add_array pids
		for pid in $service_pids; do
			case "$pid" in ''|*[!0-9]*) continue ;; esac
			json_add_int '' "$pid"
		done
		json_close_array
		json_close_object
	done
	json_close_array

	json_add_array startups
	for link in "$RC_DIR"/S[0-9][0-9]*; do
		[ -L "$link" ] || continue
		name=${link##*/}
		name=${name#???}
		case "$name" in ''|*[!A-Za-z0-9_.-]*) continue ;; esac
		json_add_string '' "$name"
	done
	json_close_array
}

route_signature() {
	local routes
	routes=$(ip "-$1" route show default 2>/dev/null) || return 1
	printf '%s\n' "$routes" | sed -E 's/ expires [^ ]+//g' | LC_ALL=C sort
}

service_https() {
	local response
	response=$(curl -q "-$1" --noproxy '*' --proto '=https' --head --connect-timeout 2 \
		--max-time 2 --output /dev/null --write-out '%{http_code}' https://example.com/ 2>/dev/null) || return 1
	case "$response" in [1-5][0-9][0-9]) return 0 ;; *) return 1 ;; esac
}

capture_network() {
	command -v curl >/dev/null 2>&1 || return 1
	route_before_v4=$(route_signature 4) || return 1
	route_before_v6=$(route_signature 6) || return 1
	resolve_name example.com || return 1
	had_web_v4=0
	had_web_v6=0
	[ -n "$route_before_v4" ] && service_https 4 && had_web_v4=1
	[ -n "$route_before_v6" ] && service_https 6 && had_web_v6=1
	[ "$had_web_v4" -eq 1 ] || [ "$had_web_v6" -eq 1 ]
}

network_still_works() {
	local v4 v6
	v4=$(route_signature 4) && v6=$(route_signature 6) || return 1
	[ "$v4" = "$route_before_v4" ] && [ "$v6" = "$route_before_v6" ] || return 1
	resolve_name example.com || return 1
	[ "$had_web_v4" -eq 0 ] || service_https 4 || return 1
	[ "$had_web_v6" -eq 0 ] || service_https 6 || return 1
}

restore_service() {
	local restored=1 command
	inspect_service "$requested_service" && [ "$service_hash" = "$was_hash" ] || return 1
	if [ "$service_enabled" -ne "$was_enabled" ]; then
		if [ "$was_enabled" -eq 1 ]; then command=enable; else command=disable; fi
		timeout 2 "$service_init" "$command" >/dev/null 2>&1 || restored=0
	fi
	if [ "$service_running" -ne "$was_running" ]; then
		if [ "$was_running" -eq 1 ]; then command=start; else command=stop; fi
		timeout 3 "$service_init" "$command" >/dev/null 2>&1 || restored=0
	fi
	inspect_service "$requested_service" && [ "$service_hash" = "$was_hash" ] &&
		[ "$restored" -eq 1 ] && [ "$service_running" -eq "$was_running" ] && [ "$service_enabled" -eq "$was_enabled" ]
}

apply_service_optimization() (
	requested_service=$1
	requested_token=$2
	stop=$3
	disable=$4
	case "$stop:$disable" in true:false|false:true|true:true) ;; *)
		repair_result rejected '请选择要执行的优化动作。'; exit ;;
	esac
	if ! mkdir "$OPTIMIZE_LOCK" 2>/dev/null; then
		repair_result busy '另一项服务优化正在执行。'
		exit
	fi
	attempted_stop=0
	attempted_disable=0
	committed=0
	trap '
		if [ "$committed" -eq 0 ] && { [ "$attempted_stop" -eq 1 ] || [ "$attempted_disable" -eq 1 ]; }; then
			restore_service
		fi
		rmdir "$OPTIMIZE_LOCK" 2>/dev/null
	' EXIT
	trap 'exit 1' HUP INT TERM
	if ! inspect_service "$requested_service" || [ "$requested_token" != "$service_token" ] ||
		{ [ "$stop" = true ] && [ "$service_running" -ne 1 ]; } ||
		{ [ "$disable" = true ] && [ "$service_enabled" -ne 1 ]; }; then
		repair_result rejected '此服务受保护、状态已变化或当前动作不可用。请重新检查。'
		exit
	fi
	if ! capture_network; then
		repair_result rejected '路由器当前未通过 DNS 和 HTTPS 基线检查，已暂停服务优化。'
		exit
	fi
	if ! inspect_service "$requested_service" || [ "$requested_token" != "$service_token" ]; then
		repair_result rejected '服务状态已变化，请重新检查后再确认。'
		exit
	fi
	was_enabled=$service_enabled
	was_running=$service_running
	was_hash=$service_hash
	expected_enabled=$was_enabled
	expected_running=$was_running
	ok=1
	if [ "$stop" = true ]; then
		attempted_stop=1
		expected_running=0
		timeout 3 "$service_init" stop >/dev/null 2>&1 || ok=0
	fi
	if [ "$ok" -eq 1 ] && [ "$disable" = true ]; then
		attempted_disable=1
		expected_enabled=0
		timeout 2 "$service_init" disable >/dev/null 2>&1 || ok=0
	fi
	if [ "$ok" -eq 1 ] && inspect_service "$requested_service" && [ "$service_hash" = "$was_hash" ] &&
		[ "$service_running" -eq "$expected_running" ] && [ "$service_enabled" -eq "$expected_enabled" ] &&
		network_still_works; then
		committed=1
		repair_result applied '服务状态已更新，路由器联网复测通过。'
	elif restore_service; then
		committed=1
		if network_still_works; then
			repair_result reverted '优化未通过复测，已恢复服务原状，路由器联网验证通过。'
		else
			repair_result reverted '已恢复服务原状，路由器联网检查仍未通过。'
		fi
	else
		repair_result attention '暂未确认服务已恢复，请到系统启动项核对状态。'
	fi
)

if [ "$1" = optimize-service ] && [ "$#" -eq 5 ]; then
	apply_service_optimization "$2" "$3" "$4" "$5"
	exit
fi

if [ "$1" = accelerate ]; then
	case "$#" in
		1) acceleration_plan; exit ;;
		3) if [ "$2" = --apply ]; then
				if [ -r "$APK_DB_LOCK" ]; then
					apply_acceleration "$3" && exit
				fi
				repair_result busy '无法锁定软件包数据库，请重新检查。'
				exit
			fi ;;
	esac
fi

case "$*" in
	scan) scan online ;;
	'scan --local') scan local ;;
	status) json_init; identity; json_dump ;;
	'fix-dns --confirm') repair_dns ;;
	*) echo 'Usage: soft-router-doctor {scan [--local]|status|fix-dns --confirm|accelerate [--apply TOKEN]}' >&2; exit 2 ;;
esac
