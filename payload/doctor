		lan_dns "$@"
		exit ;;
	lan-access)
		[ -r "$SAVED_TOPOLOGY_LIB" ] && [ -r "$LAN_ACCESS_LIB" ] ||
			{ repair_result unavailable '设备互访组件不可用。'; exit; }
		. "$SAVED_TOPOLOGY_LIB"
		. "$LAN_ACCESS_LIB"
		lan_access "$2" "$3" "$4" "$5" "$6"
		exit ;;
	site)
		[ -r "$SITE_LIB" ] || { repair_result unavailable '网站诊断组件不可用。'; exit 1; }
		[ ! -r "$QUALITY_LIB" ] || . "$QUALITY_LIB"
		. "$SITE_LIB"
