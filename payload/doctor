		[ -r "$SAVED_TOPOLOGY_LIB" ] || { repair_result unavailable '接线图组件不可用。'; exit; }
		. "$SAVED_TOPOLOGY_LIB"
		if [ "$1" = saved-topology ]; then saved_topology; else shift; edit_saved_topology "$@"; fi
