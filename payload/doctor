esac

if [ "$1" = topology ] && [ "$#" -le 2 ]; then
	[ ! -r "$MONITOR_LIB" ] || . "$MONITOR_LIB"
	network_map "$2"
	exit
fi

case "$*" in
	scan) scan online ;;
	discover-routers|'discover-routers --listen-only') discover_routers "$2" ;;
	'scan --local') scan local ;;
