{
  "luci-app-soft-router-doctor": {
    "description": "Read and diagnose this router. Separately allow guarded DNS recovery.",
    "read": {
      "ubus": {
        "soft-router-doctor": ["status", "quality", "diagnoseSite", "monitorStatus", "scan", "scanLocal", "accelerationPlan"]
      }
    },
    "write": {
      "ubus": {
        "soft-router-doctor": ["repairDns", "monitorSet", "applyAcceleration", "optimizeService"]
      }
    }
  },
  "luci-app-soft-router-doctor-topology": {
    "description": "View local network topology and edit saved route devices with separate write access.",
    "read": {
      "ubus": {
        "soft-router-doctor": ["networkMap", "discoverRouters", "savedTopology", "lanAccess"]
      }
    },
    "write": {
      "ubus": {
        "soft-router-doctor": ["editTopology"]
      }
    }
  }
}
