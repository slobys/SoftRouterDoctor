#!/bin/sh

case "$1:$2" in
	list:)
		printf '%s\n' '{"status":{},"networkMap":{},"discoverRouters":{"listenOnly":true},"scan":{},"scanLocal":{},"repairDns":{"confirm":true},"accelerationPlan":{},"applyAcceleration":{"confirm":true,"token":""},"optimizeService":{"confirm":true,"service":"","token":"","stop":true,"disable":true}}' ;;
	call:status)
		exec /usr/sbin/soft-router-doctor status ;;
	call:networkMap)
		exec /usr/sbin/soft-router-doctor topology ;;
	call:discoverRouters)
		if [ "$(jsonfilter -e '@.listenOnly' 2>/dev/null)" = true ]; then
			exec /usr/sbin/soft-router-doctor discover-routers --listen-only
		fi
		exec /usr/sbin/soft-router-doctor discover-routers ;;
	call:scan)
		exec /usr/sbin/soft-router-doctor scan ;;
	call:scanLocal)
		exec /usr/sbin/soft-router-doctor scan --local ;;
	call:accelerationPlan)
		exec /usr/sbin/soft-router-doctor accelerate ;;
	call:applyAcceleration)
		input=$(cat)
		if [ "$(printf '%s\n' "$input" | jsonfilter -e '@.confirm' 2>/dev/null)" = true ]; then
			token=$(printf '%s\n' "$input" | jsonfilter -e '@.token' 2>/dev/null)
			exec /usr/sbin/soft-router-doctor accelerate --apply "$token"
		fi
		printf '%s\n' '{"state":"rejected","detail":"请确认回收缓存。"}' ;;
	call:optimizeService)
		input=$(cat)
		param() { printf '%s\n' "$input" | jsonfilter -e "@.$1" 2>/dev/null; }
		if [ "$(param confirm)" = true ]; then
			exec /usr/sbin/soft-router-doctor optimize-service "$(param service)" \
				"$(param token)" "$(param stop)" "$(param disable)"
		fi
		printf '%s\n' '{"state":"rejected","detail":"请确认所选服务优化。"}' ;;
	call:repairDns)
		if [ "$(jsonfilter -e '@.confirm' 2>/dev/null)" = true ]; then
			exec /usr/sbin/soft-router-doctor fix-dns --confirm
		fi
		printf '%s\n' '{"state":"rejected","detail":"请确认启动 dnsmasq。"}' ;;
	*)
		exit 1 ;;
esac
